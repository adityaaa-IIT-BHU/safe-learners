rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(uid) { return request.auth != null && request.auth.uid == uid; }
    // Cybria Super Admin, or an active client admin with access to Document Verification.
    function isAdmin() {
      return request.auth != null && (request.auth.token.sa == true || (request.auth.token.admin == true
        && firestore.exists(/databases/(default)/documents/adminAccounts/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/adminAccounts/$(request.auth.uid)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/adminAccounts/$(request.auth.uid)).data.perms.get('documents', '').matches('.*v.*')));
    }
    function isImage() { return request.resource.contentType.matches('image/.*'); }
    function isDocument() { return isImage() || request.resource.contentType == 'application/pdf'; }

    // Profile and vehicle photos: public, owner-managed, images under 5 MB.
    match /photos/{uid}/{file=**} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && request.resource.size < 5 * 1024 * 1024;
    }

    // Verification documents: private to the instructor and admins, images/PDF under 10 MB.
    // Same folder the existing licence-processing function watches.
    match /licenses/{uid}/{file=**} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) && isDocument() && request.resource.size < 10 * 1024 * 1024;
    }

    // Instructor documents: the owner can add files (JPG, PNG or PDF under 10 MB) but nobody can read,
    // replace or delete them from the browser. Files are opened only through the server, for the
    // owner or an admin, so no shareable links exist.
    match /verification-documents/{uid}/{file=**} {
      allow create: if isOwner(uid)
        && request.resource.contentType in ['image/jpeg', 'image/png', 'application/pdf']
        && request.resource.size < 10 * 1024 * 1024;
      allow read, update, delete: if false;
    }

    // Legacy uploads from the old site stay readable.
    match /instructor-photos/{uid}/{file=**} { allow read: if true; }
    match /vehicle-photos/{uid}/{file=**} { allow read: if true; }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
